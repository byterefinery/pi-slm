{'path': '/workspace/site.py', 'content': '"""Generate a linked graph of 50 HTML pages and serve them on localhost.\n\nUsage:\n    python site.py [port]     # serves until interrupted\n    python site.py --generate # just (re)generate pages into ./site_pages\n"""\n\nimport random\nimport sys\nfrom pathlib import Path\n\nPAGES_DIR = Path(__file__).parent / "site_pages"\nNUM_PAGES = 50\n\nrandom.seed(42)  # deterministic graph\n\n\ndef generate_pages() -> None:\n    PAGES_DIR.mkdir(exist_ok=True)\n\n    names = [f"page{i:02d}.html" for i in range(NUM_PAGES)]\n\n    for i in range(NUM_PAGES):\n        # Each page links to 2-4 others (deterministic per page).\n        rng = random.Random(1000 + i)\n        n_links = rng.randint(2, 4)\n        targets = rng.sample(range(NUM_PAGES), n_links)\n        if i in targets:  # allow self-link occasionally? avoid it\n            targets.remove(i)\n        links = "".join(\n            f\'<a href="/{names[t]}">Page {t:02d}</a>\' for t in sorted(targets)\n        )\n        html = f"""<!DOCTYPE html>\n<html>\n<head><title>Site Crawler Demo - Page {i:02d}</title></head>\n<body>\n<h1>Page {i:02d}</h1>\n<p>This is page {i} of a synthetic crawl target.</p>\n<nav>{links}</nav>\n</body>\n</html>\n"""\n        (PAGES_DIR / names[i]).write_text(html)\n\n    print(f"Generated {NUM_PAGES} pages in {PAGES_DIR}")\n\n\nclass AccessLogHandler(__import__("http.server").SimpleHTTPRequestHandler):\n    """Serves ./site_pages with an explicit access log (one line per request)."""\n\n    def do_GET(self):\n        path = self.translate_path(self.path)\n        log_file = PAGES_DIR.parent / "access.log"\n        with open(log_file, "a") as f:\n            f.write(f"{self.path}\\n")\n        super().do_GET()\n\n    def translate_path(self, path):\n        base = __import__("http.server").SimpleHTTPRequestHandler.translate_path\n        return base(self, path)\n\n    def log_message(self, format, *args):  # quieten default stderr logging\n        pass\n\n\ndef serve(port: int = 8000) -> None:\n    import functools\n    from http.server import ThreadingHTTPServer\n\n    handler = functools.partial(AccessLogHandler, directory=str(PAGES_DIR))\n    server = ThreadingHTTPServer(("127.0.0.1", port), handler)\n    print(f"Serving {PAGES_DIR} at http://127.0.0.1:{port}/page00.html")\n    try:\n        server.serve_forever()\n    except KeyboardInterrupt:\n        pass\n\n\nif __name__ == "__main__":\n    if "--generate" in sys.argv:\n        generate_pages()\n        sys.exit(0)\n    port = int(sys.argv[1]) if len(sys.argv) > 1 and sys.argv[1].isdigit() else 8000\n    generate_pages()\n    serve(port)\n'}}], 'api': 'openai-completions', 'provider': 'openrouter', 'model': 'stealth/ox-alpha', 'usage': {'input': 168, 'output': 695, 'cacheRead': 1344, 'cacheWrite': 0, 'totalTokens': 2207, 'cost': {'input': 0.000126, 'output': 0.0024324999999999998, 'cacheRead': 0.0002016, 'cacheWrite': 0, 'total': 0.0027600999999999997}}, 'stopReason': 'toolUse', 'timestamp': 1787546548320, 'responseId': 'gen-1787546548-27z2SuSd1F33PVOfTn2e'}}, {'type': 'message', 'id': 'e9e892f5', 'parentId': '773e72a8', 'timestamp': '2026-08-24T04:42:44.672Z', 'message': {'role': 'toolResult', 'toolCallId': '91c0cf60-bbed-4be8-8704-802afbd3d309', 'toolName': 'write', 'content': [{'type': 'text', 'text': 'Successfully wrote 2524 bytes to /workspace/site.py'}], 'isError': False, 'timestamp': 1787546564672}}, {'type': 'message', 'id': '0b3d2c03', 'parentId': 'e9e892f5', 'timestamp': '2026-08-24T04:43:11.321Z', 'message': {'role': 'assistant', 'content': [{'type': 'toolCall', 'id': '6edde994-f335-4c42-9381-d24a4cc75d48', 'name': 'write', 'arguments': {'content': '"""Polite async crawler: follows same-host links, dedupes concurrent discovery."""\n\nfrom __future__ import annotations\n\nimport asyncio\nfrom collections.abc import Set as AbstractSet\nfrom urllib.parse import urljoin, urlparse\nfrom urllib.request import Request, urlopen\n\n\ndef _fetch_sync(url: str) -> str:\n    req = Request(url, headers={"User-Agent": "polite-crawler/1.0"})\n    with urlopen(req, timeout=10) as resp:\n        return resp.read().decode("utf-8", errors="replace")\n\n\nasync def crawl(\n    start_url: str,\n    concurrency: int = 6,\n    *,\n    max_pages: int | None = None,\n    gauge=None,\n) -> set[str]:\n    """Crawl same-host pages starting at *start_url*.\n\n    - Follows only links on the same host.\n    - Deduplicates URLs even when two workers discover the same link\n      simultaneously (single-flight via an asyncio.Lock).\n    - Never runs more than *concurrency* fetches in flight.\n    - Returns the set of crawled (successfully fetched) URLs.\n\n    *gauge*: optional async-callable or sync callable invoked with the\n    current number of in-flight requests after each change; used by tests.\n    """\n    if concurrency < 1:\n        raise ValueError("concurrency must be >= 1")\n\n    start_host = urlparse(start_url).netloc\n    visited: set[str] = {start_url}\n    crawled: set[str] = set()\n    queue: asyncio.Queue[str] = asyncio.Queue()\n    queue.put_nowait(start_url)\n    inflight = 0\n    lock = asyncio.Lock()  # guards `visited` checks-and-inserts (single-flight)\n\n    def notify():\n        if gauge is not None:\n            gauge(inflight)\n\n    async def worker() -> None:\n        nonlocal inflight\n        while True:\n            url = await queue.get()\n            try:\n                # Politeness: one page fetched at a time per worker, bounded pool.\n                inflight += 1\n                notify()\n                html = await asyncio.to_thread(_fetch_sync, url)\n                crawled.add(url)\n                for link in _extract_links(html, url, start_host):\n                    # Single-flight dedup: check-and-mark under the lock so two\n                    # workers discovering the same link concurrently enqueue it\n                    # exactly once.\n                    async with lock:\n                        if link in visited:\n                            continue\n                        visited.add(link)\n                        queue.put_nowait(link)\n            except Exception:\n                pass  # broken page; skip politely\n            finally:\n                inflight -= 1\n                notify()\n                queue.task_done()\n\n    def _extract_links(html: str, base_url: str, host: str) -> list[str]:\n        import re\n\n        links = []\n        for match in re.finditer(r\'href="([^"]+)"\', html):\n            absolute = urljoin(base_url, match.group(1))\n            parsed = urlparse(absolute)\n            if parsed.scheme in ("http", "https") and parsed.netloc == host:\n                normalized = parsed._replace(fragment="").geturl()\n                links.append(normalized)\n        return links\n\n    workers = [\n        asyncio.create_task(worker()) for _ in range(min(concurrency, 64))\n    ]\n    try:\n        if max_pages is not None:\n            # Stop once we\'ve crawled enough pages.\n            while len(crawled) < max_pages and not (\n                queue.empty() and all(w.done() for w in workers)\n            ):\n                await asyncio.sleep(0.01)\n        else:\n            await queue.join()\n    finally:\n        for w in workers:\n            w.cancel()\n\n    return crawled\n\n\nif __name__ == "__main__":\n    import sys\n\n    url = sys.argv[1] if len(sys.argv) > 1 else "http://127.0.0.1:8000/page00.html"\n    result: AbstractSet[str] = asyncio.run(crawl(url))\n    print(f"Crawled {len(result)} pages")\n', 'path': '/workspace/crawl.py'}}], 'api': 'openai-completions', 'provider': 'openrouter', 'model': 'stealth/ox-alpha', 'usage': {'input': 751, 'output': 860, 'cacheRead': 1472, 'cacheWrite': 0, 'totalTokens': 3083, 'cost': {'input': 0.0005632500000000001, 'output': 0.00301, 'cacheRead': 0.0002208, 'cacheWrite': 0, 'total': 0.00379405}}, 'stopReason': 'toolUse', 'timestamp': 1787546564673, 'response