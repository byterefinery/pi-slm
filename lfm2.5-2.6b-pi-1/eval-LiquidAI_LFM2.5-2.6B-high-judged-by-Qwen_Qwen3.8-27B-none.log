.', 'thinkingSignature': 'reasoning'}, {'type': 'toolCall', 'id': '51a47627-5b01-483f-8d11-0cd5e4174011', 'name': 'write', 'arguments': {'path': 'textclf.py', 'content': '"""Synthetic-topic text classification with a hard macro-F1 floor.\n\nGenerates a corpus from two word distributions (science vs sports), trains a\nTF-IDF + LinearSVC pipeline, and asserts:\n  1. Macro F1 >= 0.97 on a held-out 30% test split.\n  2. Shuffling the *training* labels only (seed 1) collapses macro F1 below\n     0.6, proving the learned signal comes from real label-token correlation.\n"""\n\nimport numpy as np\nimport pytest\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.metrics import f1_score\nfrom sklearn.pipeline import Pipeline\nfrom sklearn.svm import LinearSVC\n\nSEED = 0\nVOCAB_SIZE = 50\nOWN_TOPIC_FRAC = 0.8\nFILLER_SIZE = 30  # shared filler vocabulary size\nDOCS_PER_CLASS = 800\n\n\ndef make_vocab(prefix):\n    """Generate vocabulary programmatically: e.g. sci_00 ... sci_49."""\n    return [f"{prefix}_{i:02d}" for i in range(VOCAB_SIZE)]\n\n\nSCI_VOCAB = make_vocab("sci")\nSPORTS_VOCAB = make_vocab("spo")\nFILLER = [f"fil_{i:02d}" for i in range(FILLER_SIZE)]\n\n\ndef sample_doc(rng, own_vocab):\n    """One document: OWN_TOPIC_FRAC own-topic tokens, rest shared filler."""\n    length = int(rng.integers(30, 61))  # 30..60 tokens\n    n_own = rng.binomial(length, OWN_TOPIC_FRAC)\n    tokens = list(rng.choice(own_vocab, size=n_own))\n    tokens += list(rng.choice(FILLER, size=length - n_own))\n    rng.shuffle(tokens)\n    return " ".join(tokens)\n\n\ndef build_corpus(seed=SEED):\n    rng = np.random.default_rng(seed)\n    docs, labels = [], []\n    for _ in range(DOCS_PER_CLASS):\n        docs.append(sample_doc(rng, SCI_VOCAB))\n        labels.append(0)\n        docs.append(sample_doc(rng, SPORTS_VOCAB))\n        labels.append(1)\n    return docs, np.array(labels)\n\n\ndef make_pipeline():\n    return Pipeline(\n        [\n            ("tfidf", TfidfVectorizer()),\n            ("clf", LinearSVC(random_state=0)),\n        ]\n    )\n\n\ndef macro_f1(pipeline, X_train, y_train, X_test, y_test):\n    pipeline.fit(X_train, y_train)\n    return f1_score(y_test, pipeline.predict(X_test), average="macro")\n\n\n@pytest.fixture(scope="module")\ndef data():\n    docs, labels = build_corpus()\n    from sklearn.model_selection import train_test_split\n\n    return train_test_split(\n        docs, labels, test_size=0.3, random_state=42, stratify=labels\n    )\n\n\ndef test_real_signal_macro_f1(data):\n    X_train, X_test, y_train, y_test = data\n    score = macro_f1(make_pipeline(), X_train, y_train, X_test, y_test)\n    assert score >= 0.97, f"macro F1 {score:.4f} < 0.97"\n\n\ndef test_shuffled_labels_collapse(data):\n    X_train, X_test, _, _ = data\n    rng = np.random.default_rng(1)  # seed 1 for the label shuffle\n    shuffled_labels = rng.permutation(np.array([0, 1] * DOCS_PER_CLASS))\n    score = macro_f1(make_pipeline(), X_train, shuffled_labels, X_test, shuffled_labels[: len(X_test)])\n    # Evaluate against the same shuffled test labels so this measures pure\n    # memorization/generalization of a random labeling.\n    assert score < 0.6, f"macro F1 {score:.4f} >= 0.6 with shuffled labels"\n\n\nif __name__ == "__main__":\n    print("Run with: pytest textclf.py -v")\n'}}], 'api': 'openai-completions', 'provider': 'openrouter', 'model': 'stealth/ox-alpha', 'usage': {'input': 216, 'output': 877, 'cacheRead': 1344, 'cacheWrite': 0, 'totalTokens': 2437, 'cost': {'input': 0.000162, 'output': 0.0030694999999999997, 'cacheRead': 0.0002016, 'cacheWrite': 0, 'total': 0.0034330999999999997}}, 'stopReason': 'toolUse', 'timestamp': 1787568061418, 'responseId': 'gen-1787568061-p1wbpYAUFrQlhT2S9pDp'}}, {'type': 'message', 'id': '26d10264', 'parentId': 'bd2a20f4', 'timestamp': '2026-08-24T10:41:23.844Z', 'message': {'role': 'toolResult', 'toolCallId': '51a47627-5b01-483f-8d11-0cd5e4174011', 'toolName': 'write', 'content': [{'type':