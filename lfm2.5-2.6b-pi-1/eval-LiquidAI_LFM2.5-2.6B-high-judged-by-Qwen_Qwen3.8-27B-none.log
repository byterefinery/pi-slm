  bin_ids = np.minimum(np.digitize(p, edges[1:-1], right=False), n_bins - 1)\n\n    counts = np.bincount(bin_ids, minlength=n_bins).astype(float)\n    pos_sums = np.bincount(bin_ids, weights=y, minlength=n_bins)\n    prob_sums = np.bincount(bin_ids, weights=p, minlength=n_bins)\n\n    with np.errstate(invalid="ignore", divide="ignore"):\n        centers = prob_sums / counts\n        fractions = pos_sums / counts\n\n    return list(centers), list(fractions), counts\n\n\ndef expected_calibration_error(y_true, y_prob, n_bins: int = 10) -> float:\n    """ECE = sum_b (n_b / N) * |mean_p_b - mean_y_b| over equal-width bins."""\n    _, fractions, counts = reliability_curve(y_true, y_prob, n_bins=n_bins)\n    total = counts.sum()\n    if total == 0:\n        return float("nan")\n    ece = 0.0\n    for frac, n in zip(fractions, counts):\n        if n > 0 and np.isfinite(frac):\n            ece += (n / total) * abs(frac)\n    return float(ece)\n\n\ndef brier_score(y_true, y_prob) -> float:\n    """Mean squared error between predicted probabilities and outcomes."""\n    y = np.asarray(y_true, dtype=float).ravel()\n    p = np.asarray(y_prob, dtype=float).ravel()\n    if y.shape != p.shape:\n        raise ValueError("y_true and y_prob must have the same shape")\n    if y.size == 0:\n        raise ValueError("empty input")\n    return float(np.mean((p - y) ** 2))\n\n\ndef platt_scale(cal_probs, cal_y, eval_probs):\n    """Fit a 1-D logistic regression (logit(p) ~ a + b * logit(p)) on the\n    calibration set; apply it to eval scores.\n\n    Uses maximum-likelihood fitting with the logit of the raw score as the\n    single feature, which is exactly Platt\'s original formulation.\n    """\n    from scipy.optimize import minimize\n\n    eps = 1e-12\n    cal_p = np.clip(np.asarray(cal_probs, dtype=float).ravel(), eps, 1 - eps)\n    ev_p = np.clip(np.asarray(eval_probs, dtype=float).ravel(), eps, 1 - eps)\n    z_cal = np.log(cal_p / (1 - cal_p))\n    z_ev = np.log(ev_p / (1 - ev_p))\n    t = np.asarray(cal_y, dtype=float).ravel()\n\n    def neg_ll(params):\n        a, b = params\n        margin = a + b * z_cal\n        # numerically stable logistic loss: log(1 + exp(-margin)) + (1 - t) * margin\n        loss = np.sum(np.logaddexp(0.0, -margin) + (1.0 - t) * margin)\n        return loss\n\n    x0 = np.array([0.0, 1.0])\n    res = minimize(neg_ll, x0, method="BFGS", options={"gtol": 1e-10})\n    a, b = res.x\n    return _sigmoid(a + b * z_ev)\n\n\ndef _sigmoid(z):\n    return np.where(\n        z >= 0,\n        1.0 / (1.0 + np.exp(-z)),\n        np.exp(z) / (1.0 + np.exp(z)),\n    )\n\n\ndef make_overconfident_dataset(n_samples: int = 20000, seed: int = 0):\n    """Synthetic overconfident classifier.\n\n    True posterior P(y=1|x) = sigmoid(x) with x ~ N(0, 1.5);\n    model outputs sigmoid(2.5 * x), which is overconfident.\n    Returns (x, true_probs, reported_probs, y).\n    """\n    rng = np.random.default_rng(seed)\n    x = rng.normal(0.0, 1.5, size=n_samples)\n    true_p = _sigmoid(x)\n    reported_p = _sigmoid(2.5 * x)\n    y = (rng.random(n_samples) < true_p).astype(float)\n    return x, true_p, reported_p, y\n'}}, {'type': 'toolCall', 'id': '861d230d-bf96-4efe-918c-0c03b9bce722', 'name': 'write', 'arguments': {'path': '/workspace/test_calibrate.py', 'content': 'import numpy as np\nimport pytest\nfrom sklearn.metrics import brier_score_loss\n\nimport calibrate\nfrom calibrate import (\n    brier_score,\n    expected_calibration_error,\n    make_overconfident_dataset,\n    platt_scale,\n    reliability_curve,\n)\n\n\n@pytest.fixture(scope="module")\ndef split_data():\n    _, _, reported, y = make_overconfident_dataset(n_samples=20000, seed=0)\n    rng = np.random.default_rng(12345)\n    idx = rng.permutation(len(y))\n    half = len(y) // 2\n    cal_idx, ev_idx = idx[:half], idx[half:]\n    return {\n        "cal_p": reported[cal_idx],\n        "cal_y": y[cal_idx],\n        "ev_p": reported[ev_idx],\n        "ev_y": y[ev_idx],\n    }\n\n\ndef test_uncalibrated_ece_is_bad(split_data):\n    ece = expected_calibration_error(split_data["ev_y"], split_data["ev_p"], n_bins=10)\n    assert ece >= 0.05, f"uncalibrated ECE too low: {ece:.4f}"\n\n\ndef test_platt_improves_ece_and_brier(split_data):\n    scaled = platt_scale(split_data["cal_p"], split_data["cal_y"], split_data["ev_p"])\n\n    ece_before = expected_calibration_error(split_data["ev_y"], split_data["ev_p"], n_bins=10)\n    ece_after = expected_calibration_error(split_data["ev_y"], scaled, n_bins=10)\n    assert ece_after <= 0.02, f"calibrated ECE too high: {ece_after:.4f} (was {ece_before:.4f})"\n\n    brier_before = brier_score(split_data["ev_y"], split_data["ev_p"])\n    brier_after = brier_score(split_data["ev_y"], scaled)\n    assert brier_after < brier_before, (\n        f"Brier did not strictly improve: {brier_after:.6f} vs {brier_before:.6f}"\n    )\n\n\ndef test_brier_matches_sklearn_exactly():\n    rng = np.random.default_rng(7)\n    y = rng.integers(0, 2, size=500)\n    p = rng.random(500)\n    assert brier_score(y, p) == pytest.approx(brier_score_loss(y, p), abs=1e-12)\n\n\ndef test_reliability_curve_structure():\n    y = np.array([0, 1, 0, 1, 1, 1, 0, 0, 1, 0])\n    p = np.linspace(0.05, 0.95, 10)\n    centers, fractions, counts = reliability_curve(y, p, n_bins=10)\n    assert sum(counts) == len(y)\n    for c, f, n in zip(centers, fractions, counts):\n        if n > 0:\n            assert np.isfinite(c) and np.isfinite(f)\n            assert 0 <= f <= 1\n'}}], 'api': 'openai-completions', 'provider': 'openrouter', 'model': 'stealth/ox-alpha', 'usage': {'input': 176, 'output': 1826, 'cacheRead': 2624, 'cacheWrite': 0, 'totalTokens': 4626, 'cost': {'input': 0.000132, 'output': 0.006391, 'cacheRead': 0.00039359999999999997, 'cacheWrite': 0, 'total': 0.0069166}}, 'stopReason': 'toolUse', 'timestamp': 1787568196791, 'responseId': 'gen-1787568196-aBC7XhVvMZ4tiMlKp0qa'}}, {'type': 'message', 'id': '5612926c', 'parentId': '24b69100', 'timestamp': 